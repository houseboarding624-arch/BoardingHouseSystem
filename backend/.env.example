# Server-side only. NEVER commit the real .env or expose these in the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Long random string used to sign login cookies, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME

PORT=4000
# Where the React app runs. Development: the Vite dev server.
# GitHub Pages: the ORIGIN only (no path), e.g. https://houseboarding624-arch.github.io
CLIENT_ORIGIN=http://localhost:5173
# Set to true ONLY when the React app is on GitHub Pages and this API is hosted somewhere else (https).
CROSS_SITE=false

# Gmail used to email boarders (curfew + payment notices).
# Use a Google *App Password* (Google Account > Security > 2-Step Verification > App passwords),
# NOT your normal Gmail password.
GMAIL_USER=yourboardinghouse@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
