# Server-side only. NEVER commit the real .env or expose these in the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Long random string used to sign login cookies, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME

PORT=4000
# Only needed in development (Vite dev server origin)
CLIENT_ORIGIN=http://localhost:5173

# Gmail used to email boarders (curfew + payment notices).
# Use a Google *App Password* (Google Account > Security > 2-Step Verification > App passwords),
# NOT your normal Gmail password.
GMAIL_USER=yourboardinghouse@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
